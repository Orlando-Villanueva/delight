{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "autoIncrement": true,
      "distribution": "internal",
      "environment": "preview",
      "credentialsSource": "remote",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_API_URL": "https://delight-staging.laravel.cloud"
      }
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_URL": "https://delight-staging.laravel.cloud"
      }
    },
    "dogfood": {
      "autoIncrement": true,
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "dogfood",
        "EXPO_PUBLIC_API_URL": "https://mydelight.app"
      }
    }
  }
}
